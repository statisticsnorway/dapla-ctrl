GCP_SERVICE_ACCOUNT_EMAIL=foo@example.com
GITHUB_AUTH_ENDPOINT=fake
GOOGLE_ADMIN_SERVICE_ACCOUNT_EMAIL=foo@example.com
GOOGLE_ADMIN_USER_EMAIL=foo@example.com
INSECURE_GRPC=true
LOG_LEVEL=debug
RECONCILERS_TO_ENABLE=
PUBSUB_EMULATOR_HOST="localhost:3004"
PUBSUB_PROJECT_ID="nais-local-dev"
NAV_ONPREM_CLUSTERS=

# PAM is skipped until all four values are configured. No defaults are applied.
# PAM_MANAGED_TEAM_FOLDER_ROLE=organizations/573742569423/roles/ssb.bucket.read
# PAM_MANAGED_TEAM_FOLDER_PRINCIPALS=serviceAccount:reader@example.iam.gserviceaccount.com,group:readers@example.com
# PAM_MANAGED_TEAM_FOLDER_MAX_GRANT_DURATION=1h
# PAM_MANAGED_TEAM_FOLDER_CONDITION_TEMPLATE='{{- $bucket := `(resource.type == "storage.googleapis.com/Bucket" ? resource.name.extract("projects/_/buckets/{bucket}") : resource.name.extract("projects/_/buckets/{bucket}/"))` -}}resource.type in ["storage.googleapis.com/Bucket", "storage.googleapis.com/Object"] && {{$bucket}}.endsWith({{printf "%q" (printf "-%s" .Env)}}) && ({{$bucket}} == {{printf "%q" (printf "ssb-%s-data-produkt-%s" .TeamSlug .Env)}} || ({{$bucket}}.startsWith({{printf "%q" (printf "ssb-%s-data-delt-" .TeamSlug)}}) && {{$bucket}} != {{printf "%q" (printf "ssb-%s-data-delt--%s" .TeamSlug .Env)}} && {{$bucket}} != {{printf "%q" (printf "ssb-%s-data-delt-delomat--%s" .TeamSlug .Env)}}))'