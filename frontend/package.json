{
	"name": "console-frontend",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"prepare": "cd .. && husky frontend/.husky && cd frontend && svelte-kit sync || echo ''",
		"dev": "vite dev",
		"dev-live-share": "vite dev --host ::",
		"build": "vite build",
		"preview": "vite preview",
		"check": "houdini generate && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"eslint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest",
		"lint-staged": "lint-staged",
		"unused": "node find-unused-gql.mjs && echo '---' && node find-missing-css-vars.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@nais/ds-svelte-community": "2.0.0-next.8",
		"@navikt/ds-css": "8.21.0",
		"@navikt/ds-tokens": "8.21.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/papaparse": "^5.5.2",
		"@types/sortablejs": "^1.15.9",
		"date-fns": "^4.4.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-unicorn": "^79.0.0",
		"globals": "^17.13.0",
		"houdini": "^2.0.13",
		"houdini-svelte": "^3.0.7",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"graphql": "^17.0.2",
		"graphql-sse": "^2.6.3",
		"papaparse": "^5.7.0",
		"pino": "^10.4.0",
		"sortablejs": "^1.15.7"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.0"
		}
	},
	"lint-staged": {
		"*.{js,ts,svelte,gql,css,md,json}": "prettier --write .",
		"*.{js,ts,svelte,gql}": [
			"eslint --fix .",
			"svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
		]
	},
	"graphql": {
		"schema": "https://localhost:3000/graphql",
		"documents": "**/*.{graphql,js,ts,jsx,tsx,svelte}"
	},
	"peerDependencies": {
		"@nais/ds-svelte-community": "^2.0.0-next.8",
		"@navikt/ds-css": "8.21.0",
		"@navikt/ds-tokens": "8.21.0"
	}
}
