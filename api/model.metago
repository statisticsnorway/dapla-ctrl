    {{ name . }}Connection = pagination.Connection[{{ if ne .Kind "interface"}}*{{ end }}{{ name . }}]
    {{ name . }}Edge = pagination.Edge[{{ if ne .Kind "interface"}}*{{ end }}{{ name . }}]
)
{{ end }}

